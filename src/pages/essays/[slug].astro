---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map(essay => ({
    params: { slug: essay.slug },
    props: { essay },
  }));
}

interface Props { essay: CollectionEntry<'essays'>; }
const { essay } = Astro.props;
const { Content } = await essay.render();

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

// Rough reading time estimate
const wordCount = essay.body.split(/\s+/).length;
const readTime = Math.ceil(wordCount / 200);
---

<BaseLayout title={essay.data.title} description={essay.data.description}>
  <main>
    <nav class="breadcrumb">
      <a href="/">Dia Manoj</a>
      <span>/</span>
      <a href="/#essays">Short Stories / Essays</a>
    </nav>

    <article>
      <header>
        <h1>{essay.data.title}</h1>
        <div class="meta">
          <time>{formatDate(essay.data.date)}</time>
          <span class="sep">·</span>
          <span class="read-time">{readTime} min read</span>
        </div>
        {essay.data.description && (
          <p class="description">{essay.data.description}</p>
        )}
        {essay.data.tags && (
          <div class="tags">
            {essay.data.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        )}
      </header>

      <div class="essay-body">
        <Content />
      </div>
    </article>

    <a href="/" class="back">← back</a>
  </main>
</BaseLayout>

<style>
  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 0 6rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 3.5rem;
  }

  .breadcrumb a:hover { color: var(--accent); }
  .breadcrumb span { color: var(--text-dim); }

  article header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--text-dim);
  }

  .sep { color: var(--text-dim); }

  .description {
    margin-top: 1rem;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .tag {
    font-family: var(--font-ui);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.15rem 0.5rem;
  }

  /* ── Essay body ── */
  .essay-body {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--text);
  }

  .essay-body :global(p) {
    margin-bottom: 1.5em;
  }

  .essay-body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--text);
    margin: 2.5em 0 0.75em;
    letter-spacing: -0.01em;
  }

  .essay-body :global(h3) {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 2em 0 0.75em;
  }

  .essay-body :global(blockquote) {
    border-left: 2px solid var(--accent-dim);
    margin: 2em 0;
    padding: 0.25em 0 0.25em 1.5em;
    font-style: italic;
    color: var(--text-muted);
  }

  .essay-body :global(em) { font-style: italic; }
  .essay-body :global(strong) { font-weight: 500; color: var(--text); }

  .essay-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 3em auto;
    width: 4rem;
  }

  .essay-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--accent-dim);
  }

  .essay-body :global(a:hover) { color: var(--text); }

  .back {
    display: inline-block;
    margin-top: 4rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .back:hover { color: var(--accent); }
</style>
